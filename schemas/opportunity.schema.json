{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpportunityBridge Opportunity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "num",
    "id",
    "name",
    "organization",
    "type",
    "displayType",
    "description",
    "statusNote",
    "stages",
    "interests",
    "states",
    "requiredSignals",
    "preferredSignals",
    "excludedSignals",
    "sourceUrl",
    "sourceLabel",
    "statusHint",
    "active",
    "lastVerifiedAt",
    "featured",
    "award"
  ],
  "properties": {
    "num": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "organization": {
      "type": "string",
      "minLength": 2
    },
    "type": {
      "enum": [
        "scholarship",
        "fellowship",
        "internship",
        "research",
        "college access",
        "study abroad",
        "career"
      ]
    },
    "displayType": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "statusNote": {
      "type": "string",
      "minLength": 4
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "institutions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "requiredSignals": {
